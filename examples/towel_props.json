{
  "tagLine": "高阳毛巾 · 工厂直发",
  "segments": [
    { "text": "酒店的毛巾为啥那么舒服", "from": 0, "durationInFrames": 72, "highlight": "酒店" },
    { "text": "自己家买的又硬又掉毛", "from": 81, "durationInFrames": 66, "highlight": "掉毛" },
    { "text": "差距就俩字：克重", "from": 156, "durationInFrames": 60, "highlight": "克重" },
    { "text": "便宜毛巾克重才60克", "from": 225, "durationInFrames": 63, "highlight": "60克" },
    { "text": "我们高阳这条足足110克", "from": 297, "durationInFrames": 75, "highlight": "110克" },
    { "text": "拿手里沉甸甸的", "from": 381, "durationInFrames": 54, "highlight": "沉甸甸" },
    { "text": "32股长绒棉，纯棉的", "from": 444, "durationInFrames": 69, "highlight": "长绒棉" },
    { "text": "倒上水，一秒就吸进去", "from": 522, "durationInFrames": 66, "highlight": "一秒" },
    { "text": "擦脸擦头发，不掉毛不掉色", "from": 597, "durationInFrames": 78, "highlight": "不掉毛" },
    { "text": "越洗越软，绝不发硬", "from": 684, "durationInFrames": 63, "highlight": "越洗越软" },
    { "text": "高阳，中国毛巾之都", "from": 756, "durationInFrames": 66, "highlight": "毛巾之都" },
    { "text": "全国三条毛巾一条出自这儿", "from": 831, "durationInFrames": 78, "highlight": "三条毛巾" },
    { "text": "工厂直发，没有中间商赚差价", "from": 918, "durationInFrames": 81, "highlight": "工厂直发" },
    { "text": "商场里这种货卖三四十一条", "from": 1008, "durationInFrames": 78, "highlight": "三四十" },
    { "text": "现在工厂价你猜多少", "from": 1095, "durationInFrames": 63, "highlight": "工厂价" },
    { "text": "点下方小黄车看价格", "from": 1167, "durationInFrames": 66, "highlight": "小黄车" },
    { "text": "想要的扣个1，给你留货", "from": 1242, "durationInFrames": 78, "highlight": "扣个1" }
  ]
